# Everything works without this file. Copy it to .env only if you need a setting.

# PORT=4600

# Path to Chrome, Edge or Chromium if it is not in the usual place.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Adds a "Make photoreal" button to the generated visuals. When you press it,
# that one image and the project's building settings are sent to OpenAI, which charges per image.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
